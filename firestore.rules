// Permisos de la base de datos (Firestore, proyecto gestor-hostal).
// Solo Glenda, con la sesión iniciada, puede leer o escribir: ni los datos del hostal
// ni las fotos de los tickets (colección `justificantes`) se ven desde fuera.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'glendapostigo@yahoo.com';
    }
  }
}
