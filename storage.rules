// Reglas del almacén de justificantes (Firebase Storage, proyecto gestor-hostal).
// Se pegan en: consola de Firebase → Storage → Reglas → Publicar.
//
// Qué hacen: solo alguien con sesión iniciada puede ver o subir fotos de tickets,
// y cada archivo se limita a 10 MB y a ser una imagen. Nadie de fuera entra.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /justificantes/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
